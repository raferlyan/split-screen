<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      覆盖 WMShell 自带的配置（frameworks/base/libs/WindowManager/Shell/res/values/config.xml）。
      true：WMShell 跑在独立的 wmshell.main 线程（THREAD_PRIORITY_DISPLAY），不和本进程 UI 线程抢。
      AOSP 默认是 false，由各设备 overlay 打开；自研 SystemUI 很容易漏掉这一项。
    -->
    <bool name="config_enableShellMainThread">true</bool>

    <dimen name="nav_bar_height">48dp</dimen>
    <dimen name="nav_button_width">96dp</dimen>
    <dimen name="picker_width">320dp</dimen>
    <dimen name="card_gap">32dp</dimen>
    <dimen name="card_radius">16dp</dimen>

    <!--
      分屏分隔条，覆盖 WMShell 同名资源。
      底色和导航栏同一个深灰（不用纯黑），两侧应用画 16dp 圆角，把手是半透明白色短胶囊。
    -->
    <color name="sys_canvas">#FF1F1F23</color>
    <color name="split_divider_background">@color/sys_canvas</color>
    <color name="docked_divider_handle">#8CFFFFFF</color>
    <dimen name="split_divider_bar_width">12dp</dimen>
    <dimen name="split_corner_radius">16dp</dimen>
    <dimen name="split_divider_handle_width">40dp</dimen>
    <dimen name="split_divider_handle_height">4dp</dimen>

    <color name="exit_scrim">#B3000000</color>
    <color name="picker_scrim">#66000000</color>
    <color name="picker_bg">#F2202124</color>

    <style name="Theme.SplitSysUI" parent="@android:style/Theme.DeviceDefault.NoActionBar" />
</resources>
